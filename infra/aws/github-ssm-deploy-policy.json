      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-south-1:049681811107:instance/i-02fd037d73f8a7b68"
      ]
    },
    {
      "Sid": "ReadDeploymentCommandResult",
